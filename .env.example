# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em
# Settings → Environment Variables e faça um novo deploy (as NEXT_PUBLIC_ entram no build).
# Sem as variáveis do Supabase o app roda em "modo local" (dados só no navegador).

# --- Públicas (vão para o navegador; tipo "Config" na Vercel) -------------------------
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys → anon / publishable
# (também aceita o nome NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# --- Somente servidor (NUNCA com prefixo NEXT_PUBLIC_; tipo "Sensitive" na Vercel) ------
# Necessária para o registro com aprovação (criar contas aprovadas).
# Supabase → Project Settings → API Keys → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=

# SMTP para os e-mails de aprovação/recusa (use o mesmo configurado no Supabase).
# Gmail: smtp.gmail.com / 465 / seu-email@gmail.com / senha de app
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monerpy <seu-email@gmail.com>"

# Opcional: recebe aviso por e-mail a cada novo pedido de registro.
ADMIN_EMAIL=
# Opcional: URL pública usada nos links dos e-mails (padrão: a URL acessada).
APP_URL=https://monerpy.vercel.app
