# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem estas variáveis o app roda em "modo local".
# Na Vercel, cadastre as mesmas variáveis (Production + Preview) e faça um novo deploy:
# elas são embutidas no app durante o build.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Também aceita o nome NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (criado pela integração Supabase ↔ Vercel).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
